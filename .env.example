# --- Server ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL (docker compose up -d in Phase 2) ---
DATABASE_URL=postgres://widgets:widgets@localhost:5432/widgets

# --- Admin auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Public CORS ---
# Public endpoints are anonymous (no cookies), so allow any origin with "*".
# Admin API is not CORS-exposed; the stats page is served from the API origin.
CORS_PUBLIC_ORIGIN=*

# --- Widget bundle version ---
# Bump on release; the embed snippet emits this value and cache goes immutable.
WIDGET_SCRIPT_VERSION=v1

# --- Public submission limits ---
BODY_LIMIT_KB=16

# --- Rate limiting (sliding window, per process) ---
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_WIDGET_MAX=20
RATE_LIMIT_WINDOW_SEC=60

# --- Geo enrichment fallback chain (no API key required) ---
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=1500
# real | mock - mock makes fallback proofs deterministic (Phase 2)
GEO_MODE=real

# --- Email side effect (Mailpit catches mail locally; failure must never block a submission) ---
EMAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@widget.local
OWNER_NOTIFY_EMAIL=
