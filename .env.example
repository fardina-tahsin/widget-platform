# Copy to .env and adjust. .env is git-ignored.

# --- Server ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL (docker compose up -d) ---
DATABASE_URL=postgres://widgets:widgets@localhost:5432/widgets

# --- Admin auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Public CORS (anonymous endpoints, no credentials) ---
CORS_PUBLIC_ORIGIN=*

# --- Versioned widget bundle ---
WIDGET_SCRIPT_VERSION=v1

# --- Submission limits ---
BODY_LIMIT_KB=16
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_WIDGET_MAX=20
RATE_LIMIT_WINDOW_SEC=60

# --- Geo enrichment fallback chain ---
# real: ip-api.com -> ipapi.co. mock: deterministic local providers.
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=1500
GEO_MODE=real
MOCK_GEO_A=up
MOCK_GEO_B=up

# --- Email side effect (Mailpit catches mail locally) ---
EMAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@widget.local
OWNER_NOTIFY_EMAIL=
